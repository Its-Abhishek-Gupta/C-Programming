//WAP to check whether the entered number is prime or not.
#include<stdio.h>
#include<stdlib.h>
int main()
{
    int n,i,c=0;
    printf("Enter the number:");
    scanf("%d",&n);
    if (n<2){
        printf("Enter number greater than 2");
        return 0;
        exit(0);
    }
    else{
        for (i=2;i<n;i++)
        {
            if (n%i==0)
                c++;
        }
        if (c==0)
            printf("The number %d is prime",n);
        else
            printf("The number %d is not prime",n);
    }
    return 0;
}
