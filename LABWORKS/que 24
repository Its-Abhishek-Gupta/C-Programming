#include<stdio.h>
int main()
{
    int a[10],min,max,i,n;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    min=a[0];
    max=a[0];
    for (i=0;i<n;i++){
        if (a[i]>=max)
            max=a[i];
        if (a[i]<=min)
            min=a[i];
    }
    printf("Maximum element is: %d",max);
    printf("Minimum element is: %d",min);
    return 0;
}
