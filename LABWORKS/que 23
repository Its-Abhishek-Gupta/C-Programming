#include<stdio.h>
int main()
{
    int a[10],s=0,n,i;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    for (i=0;i<n;i++)
        s+=a[i];
    printf("Sum of the array elements are:%d",s);
    return 0;
}
