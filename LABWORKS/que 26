#include<stdio.h>
void InsertionSort(int arr[],int n);
int main()
{
    int a[10],n,i;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    InsertionSort(a,n);
    printf("The sorted array is:");
    for (i=0;i<n;i++)
        printf("\t%d",a[i]);
    return 0;
}
void InsertionSort(int arr[],int n)
{
    int i,j,key;
    for (i=1;i<=n-1;i++)
    {
        key=arr[i];
        j=i-1;
        while(j>=0 && arr[j]>key){
            arr[j+1]=arr[j];
            j--;}
        arr[j+1]=key;
    }
}
