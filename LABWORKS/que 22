#include<stdio.h>
int main()
{
    int a[10],b[10],c[10],i,n1,n2;
    printf("Enter the size of array a and b: ");
    scanf("%d%d",&n1,&n2);
    if (n1!=n2)
        printf("Please enter array of same size:");
    else{
        printf("Enter the elements of array a:");
        for (i=0;i<n1;i++)
            scanf("%d",&a[i]);
        printf("Enter the elements of the array b:");
        for (i=0;i<n2;i++)
            scanf("%d",&b[i]);
        for (i=0;i<n1;i++)
            c[i]=a[i]+b[i];
        printf("Array after adding elements are:");
        for (i=0;i<n1;i++)
            printf("\t%d",c[i]);
    }
    return 0;
}
