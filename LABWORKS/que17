//WAP to find the sum of digits of the entered number.
#include<stdio.h>
int main()
{
    int n,r,i,s=0;
    printf("Enter the number:");
    scanf("%d",&n);
    while (n!=0){
        r=n%10;
        s=s+r;
        n=n/10;
    }
    printf("The sum of the digits of the %d is %d ",n,s);
    return 0;
}
