#include<stdio.h>
int main()
{
    int a[10],se,n,i,loc=-1;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter the elements to be searched:");
    scanf("%d",&se);
    for (i=0;i<n;i++)
    {
        if (se==a[i])
            loc=i;
    }
    if (loc==-1)
        printf("Element is not present in the array");
    else
        printf("Element is present at the position %d",loc+1);
    return 0;
}
