//WAP to print the Fibonacci series.
#include<stdio.h>
int main()
{
    int a,b,c,n,i;
    printf("Enter number of terms of series:");
    scanf("%d",&n);
    i=0;
    a=1;
    b=1;
    printf("\n%d\n%d",a,b);
    for (i=3;i<=n;i++)
    {
        c=a+b;
        printf("\n%d",c);
        a=b;
        b=c;
    }
    return 0;
}
