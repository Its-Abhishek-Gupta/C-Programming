#include<stdio.h>
void SelectionSort(int a[],int n){
    int i,j,minindex,t;
    for (i=0;i<n-1;i++)
    {
        minindex=i;
        for (j=i+1;j<n-1;j++){
            if (a[j]<a[minindex])
                minindex=j;
        }
        t=a[i];
        a[i]=a[minindex];
        a[minindex]=t;
    }
}
int main()
{
    int a[10],n,i;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array elements:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    SelectionSort(a,n);
    printf("The sorted array is:");
    for (i=0;i<n;i++)
        printf("\t%d",a[i]);
    return 0;
}
