#include<stdio.h>
void BubbleSort(int arr[],int n);
int main()
{
    int a[10],i,n;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the elements of the array:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    BubbleSort(a,n);
    printf("The array after sorting is :");
    for (i=0;i<n;i++)
        printf("\t%d",a[i]);
    return 0;
}
void BubbleSort(int a[],int n){
    int i,j,t;
    for (i=0;i<n-1;i++){
        for (j=0;j<n-1-i;j++){
            if (a[j]>a[j+1]){
                t=a[j];
                a[j]=a[j+1];
                a[j+1]=t;
            }
        }
    }
}
