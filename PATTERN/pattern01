#include<stdio.h>
int main()
{
    int i,j;
    for (j=1;j<=4;j++)
    {
        for (i=1;i<=j;i++){
            if (j%2!=0){
                if (i%2==0)
                    printf("%d",0);
                else
                    printf("%d",1);
            }
            else{
                if (i%2==0)
                    printf("1");
                else
                    printf("0");
            }
        }
        printf("\n");
    }
}
