#include<stdio.h>
int main()
{
    int a[10],b[10],i,j,n1,n2;
    printf("Enter the size of the array a n1=");
    scanf("%d",&n1);
    printf("Enter the elements of the array a:");
    for (i=0;i<n1;i++)
        scanf("%d",&a[i]);
    printf("Enter the size of the array b n2=");
    scanf("%d",&n2);
    printf("Enter the elements of the array b:");
    for (j=0;j<n2;j++)
        scanf("%d",&b[j]);
    j=0;
    for (i=n1;i<n1+n2;i++)
    {
        a[i]=b[j];
        j++;
    }
    n1=n1+n2;
    printf("Merged array is:");
    for (i=0;i<n1;i++)
        printf("\na[%d]=\t%d",i,a[i]);
    return 0;
}
