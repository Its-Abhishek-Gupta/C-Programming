#include<stdio.h>
int main(){
    int a[100],i,n,s;
    printf("Enter the number of elements of the array:");
    scanf("%d",&n);
    for (i=0;i<n;i++){
        printf("Enter the element%d ",i+1);
        scanf("%d",&a[i]);
    }
    s=a[0];
    for (i=0;i<n;i++){
        if (a[i]<s)
            s=a[i];
    }
    printf("Smallest Element Of Array Is%d",s);
    return 0;
}
