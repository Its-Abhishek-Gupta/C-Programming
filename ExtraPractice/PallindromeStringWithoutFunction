#include<stdio.h>
#include<string.h>
int main()
{
    char a[100],b[100];
    int i,rev,j,l=0;
    printf("Enter the string a:");
    scanf("%s",a);
    while (a[l]!='\0'){
        l++;
    }
    printf("\nLength is:%d",l);
    i=l-1;
    j=0;
    while (i>=0){
        b[j]=a[i];
        i--;
        j++;
    }
    b[l]='\0';
    printf("\nReversed string is: %s",b);
    j=0;
    while (a[j]!='\0' && b[j]!='\0'){
        if (a[j]!=b[j]){
            i=0;
            break;
        }
        else
            i=1;
        j++;
    }
    if (i==1)
        printf("\nString is pallindrome");
    else 
        printf("\nString is not pallindrome");
    return 0;
}
