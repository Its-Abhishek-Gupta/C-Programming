#include<stdio.h>
int main(){
    int a[100],i,n,s1=0,s2=0;
    printf("Enter the number of elements of the array:");
    scanf("\n%d",&n);
    for (i=0;i<n;i++){
        printf("Enter the element%d ",i+1);
        scanf("\n%d",&a[i]);
    }
    for (i=0;i<n;i++){
        if (a[i]%2==0)
            s1=s1+a[i];
        else
            s2=s2+a[i];
    }
    printf("\nSum of even elements are:=%d",s1);
    printf("\nSum of odd elements are:%d",s2);
    return 0;
}
