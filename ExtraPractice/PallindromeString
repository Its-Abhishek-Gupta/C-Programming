#include<stdio.h>
#include<string.h>
int main()
{
    char a[100],b[100];
    int i;
    printf("Enter the string a:");
    scanf("%s",a);
    strcpy(b,a);
    strrev(b);
    i=strcmp(a,b);
    if (i==0)
        printf("\nPallindrome String");
    else
        printf("\nNon Pallimdrome String");
    return 0;
}
