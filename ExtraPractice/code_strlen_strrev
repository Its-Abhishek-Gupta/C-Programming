#include<stdio.h>
#include<string.h>
int main()
{
    char a[100],b[100];
    int i,l,j;
    printf("Enter the string a:");
    scanf("%s",a);
    l=0;
    while (a[l]!='\0')
        l++;
    printf("The length of the string is %d:",l);
    j=l-1;
    i=0;
    while (j>=0){
        b[i]=a[j];
        i++;
        j--;
    }
    b[l]='\0';
    printf("\nThe string after reversing is %s",b);
    return 0;
}
