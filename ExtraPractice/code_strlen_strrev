#include<stdio.h>
int main()
{
    char a[100],b[100];
    int i,l;
    printf("Enter the string a:");
    scanf("%s",a);
    l=0;
    while (a[l]!='\0')
        l++;
    printf("The length of the string is %d:",l);
    l=l-1;
    i=0;
    while (l>=0){
        b[i]=a[l];
        i++;
        l--;
    }
    b[l]='\0';
    printf("The string after reversing is %s",b);
    return 0;
}
