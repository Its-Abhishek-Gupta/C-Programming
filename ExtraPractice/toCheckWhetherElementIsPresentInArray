#include<stdio.h>
int main(){
    int a[10],i,n,s,c=0;
    printf("Enter the number of elements of the array:");
    scanf("%d",&n);
    for (i=0;i<n;i++){
        printf("Enter the element%d ",i+1);
        scanf("%d",&a[i]);
    }
    printf("Enter the element to search in the Array:");
    scanf("%d",&s);
    for (i=0;i<n;i++){
        if (s==a[i])
            c++;
    }
    if (c!=0)
        printf("\nThe element is present in the array:");
    else
        printf("The element is not present int the array");
    return 0;
}
