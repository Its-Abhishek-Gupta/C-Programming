#include<stdio.h>
int main()
{
    int i,j,c=0;
    i=1;
    while (i<=100)
    {
        for (j=2;j<i;j++)
        {
            if (i%j==0)
                c++;
            else
                c=0;
        }
        if (c==0)
            printf("%d\t",i);
        c=0;
        i++;
    }
    return 0;
}
