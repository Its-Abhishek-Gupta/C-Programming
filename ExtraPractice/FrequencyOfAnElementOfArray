#include<stdio.h>
int main()
{
    int a[10],i,n,nf,c=0;
    printf("\nEnter the size of the array:");
    scanf("%d",&n);
    printf("Enter the %d elements of the array:",n);
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("\nEnter the element to find the frequency:");
    scanf("%d",&nf);
    for (i=0;i<n;i++)
    {
        if (a[i]==nf){
            c=c+1;
        }
    }
    printf("The frequency of the element %d",nf);
    printf("is %d",c);
    return 0;
}
