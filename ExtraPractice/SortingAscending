#include<stdio.h>
int main()
{
    int a[10],i,j,n,t;
    printf("Enter the size of array n:");
    scanf("%d",&n);
    printf("\nEnter the %d elements of the array:",n);
    for (i=0;i<n;i++)
        scanf("\n%d",&a[i]);
    for (i=0;i<n-1;i++)
    {
        for(j=0;j<n-1-i;j++)
        {
            if (a[j]>a[j+1]){
                t=a[j];
                a[j]=a[j+1];
                a[j+1]=t;
            }
        }
    }
    printf("\nThe array after swapping is:");
    for (i=0;i<n;i++)
        printf("%d\t",a[i]);
    return 0;
}
