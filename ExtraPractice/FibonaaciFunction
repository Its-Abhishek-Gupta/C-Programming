#include<stdio.h>
void fib(int);
int main()
{
    int n;
    printf("Enter the number of terms:");
    scanf("%d",&n);
    fib(n);
    return 0;
}
void fib(int n)
{
    int a,b,c,i;
    a=0;b=1;
    printf("%d\t%d",a,b);
    for (i=2;i<n;i++)
    {
        c=a+b;
        printf("\t%d",c);
        a=b;
        b=c;
    }
}
