#include<stdio.h>
int main(){
    int i,s=0,n;
    int a[100];
    printf("enter the number of elements you want to enter in the array:");
    scanf("%d",&n);
    for (i=0;i<n;i++){
        scanf("\n%d",&a[i]);
    }
    for (i=0;i<=n;i++){
        s=s+a[i];
    }
    printf("\nSum of elements of the array is:%d",s);
    return 0;
}
