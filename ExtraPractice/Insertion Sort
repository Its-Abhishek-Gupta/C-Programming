//Insertion sorting technique
#include<stdio.h>
void InsertionSort(int arr[],int n)
{
    int i,j,key;
    for (i=1;i<=n-1;i++)
    {
        j=i-1;
        key=arr[i];
        while(j>=0 && arr[j]>key)
        {
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=key;
    }
}
int main()
{
    int a[10],i,n;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the array:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("The inserted array is :");
    for (i=0;i<n;i++)
        printf("\t%d",a[i]);
    InsertionSort(a,n);
    printf("\nThe sorted array is:");
    for (i=0;i<n;i++)
        printf("\t%d",a[i]);
    return 0;
}
