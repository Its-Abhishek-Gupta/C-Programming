#include<stdio.h>
int main()
{
    int a[10],i,n,r;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the elements of the array:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    for (i=0;i<n/2;i++)
    {
        r=a[i];
        a[i]=a[n-1-i];
        a[n-1-i]=r;
    }
    printf("The reversed array is:");
    for (i=0;i<n;i++)
        printf("\na[%d]=%d",i,a[i]);
    return 0;
}
