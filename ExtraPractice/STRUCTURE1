//Create a suitable structure in C language for keeping the records of the employees of organization about their id, name, designation, department, city of posting. Also
//write a program in C to enter the record of 100 employees and display the name of those who earn more than 20000.
#include<stdio.h>
struct employees 
{
    char name[100],designation[100],department[100],CityOfPosting[100];
    int id,salary;
};
int main()
{
    struct employees s[100];
    int i,j,n;
    printf("Enter the number of employees :");
    scanf("%d",&n);
    for (i=0;i<n;i++)
    {
        printf("Enter the details of the employee %d \n",i+1);
        scanf("%s%s%s%s%d%d",s[i].name,s[i].designation,s[i].department,s[i].CityOfPosting,&s[i].id,&s[i].salary);
    }
    for (i=0;i<n;i++)
    {
        if (s[i].salary>20000)
        {
            printf("\n The details of the %d employee is \n",i+1);
            printf("Name=%s\tDesignation=%s\tDepartment=%s\tCity of posting=%s\t id=%d\t salary=%d\t",s[i].name,s[i].designation,s[i].department,s[i].CityOfPosting,s[i].id,s[i].salary);            
        }
    }
    return 0;
}
