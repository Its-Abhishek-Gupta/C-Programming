#include<stdio.h>
int main()
{
    int a[10][10],b[10][10],c[10][10],n,i,j,k,s=0;
    printf("Enter the dimension of the matrix as n:");
    scanf("%d",&n);
    printf("Enter the matrix a:");
    for (i=0;i<n;i++){
        for (j=0;j<n;j++)
        {
            scanf("%d",&a[i][j]);
        }
    }
    printf("Enter the matrix b:");
    for (i=0;i<n;i++){
        for (j=0;j<n;j++)
        {
            scanf("%d",&b[i][j]);
        }
    }
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
        {
            if (i==j)
                s+=a[i][j];
        }
    }
    printf("Sum of diagonal elements of a is: %d \n",s);
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
            c[i][j]=a[i][j]+b[i][j];
    }
    printf("The sum of the matrices is \n");
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
            printf("\t%d",c[i][j]);
        printf("\n");
    }
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
        {
            c[i][j]=0;
            for (k=0;k<n;k++)
                c[i][j]+=a[i][k]*b[k][i];
        }
    }
    printf("\nThe product of the matrices is:\n");
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
            printf("\t%d",c[i][j]);
        printf("\n");
    }
    return 0;
}
