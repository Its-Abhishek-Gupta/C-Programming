#include<stdio.h>
int main(){
    int a[100],i,n,l;
    printf("Enter the number of elements you want to enter in the array:");
    scanf("%d",&n);
    for (i=0;i<n;i++){
        printf("Enter the element%d ",i+1);
        scanf("%d",&a[i]);    
    }
    l=a[0];
    for (i=0;i<n;i++){
        if (a[i]>l)
            l=a[i];
    }
    printf("\nLargest element is=%d",l);
    return 0;
}
