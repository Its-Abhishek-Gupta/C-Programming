#include<stdio.h>
int main()
{
    int a,b;
    int swap(int a,int b);
    printf("Enter the two numbers to swap:");
    scanf("%d%d",&a,&b);
    printf("The numbers before swapping are %d and %d",a,b);
    swap(a,b);
    return 0;
}
int swap (int x,int y)
{
    int t;
    t=x;
    x=y;
    y=t;
    printf("\nThe numbers after swapping are:%d anf %d",x,y);
}
