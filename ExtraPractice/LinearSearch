#include<stdio.h>
int main()
{
    int a[100],i,n,se,loc=-1;
    printf("Enter the size of the array:");
    scanf("%d",&n);
    printf("Enter the list:");
    for (i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter the element to be searched:");
    scanf("%d",&se);
    for (i=0;i<n;i++){
        if (a[i]==se){
            loc=i;
            break;
        }
    }
    if (loc==-1)
        printf("\nElement is not present in the array");
    else
        printf("\nThe element is present at the position %d",i+1);
    return 0;
}
