#include<stdio.h>
#include<stdlib.h>
int main()
{
    int a[10][10],s=0,i,j,m,n;
    printf("Enter the dimensions of the array:");
    scanf("%d%d",&m,&n);
    printf("Enter the matrix a:\n");
    for (i=0;i<m;i++)
    {
        for (j=0;j<n;j++)
            scanf("%d",&a[i][j]);
    }
    if (m!=n)
    {
        printf("Entered matrix is not a diagonal matrix");
        return 0;
        exit(0);
    }
    for (i=0;i<n;i++)
    {
        for (j=0;j<n;j++)
        {
            if (i==j)
                s+=a[i][j];
        }
    }
    printf("\nThe sum of the diagonal elements of the array is:%d",s);
    return 0;
}
